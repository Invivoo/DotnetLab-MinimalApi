### Get All

GET {{BaseAddress}}/communities
Accept: application/json

### Add a community
# @name newCommunityToBeDeleted
POST {{BaseAddress}}/communities
Content-Type: application/json

{
  "name":"A Short lived community",
  "description": "A New community that will be deleted"
}

### Get New Community that will be deleted

GET {{BaseAddress}}/communities/{{newCommunityToBeDeleted.response.body.$.id}}
Accept: application/json

### Delete By Id

DELETE {{BaseAddress}}/communities/{{newCommunityToBeDeleted.response.body.$.id}}

### Add a community
# @name newCommunity
POST {{BaseAddress}}/communities
Content-Type: application/json

{
  "name":"A New Community",
  "description": "A New community for the patches"
}


### Get By Id

GET {{BaseAddress}}/communities/{{newCommunity.response.body.$.id}}
Accept: application/json

### Json Merge Patch

PATCH {{BaseAddress}}/communities/{{newCommunity.response.body.$.id}}/json-merge-patch
Content-Type: application/json

{
  "name":"modified from merge patch"
}

### Json Patch

PATCH {{BaseAddress}}/communities/{{newCommunity.response.body.$.id}}/json-patch
Content-Type: application/json-patch+json

[
  {
    "op": "replace",
    "path": "/Name",
    "value": "patched community name"
  },
  {
    "op": "add",
    "path": "/Manager/FirstName",
    "value": "Patched manager first name"
  },
  {
    "op": "add",
    "path": "/Expertises",
    "value": [{ "Name": "New Expertise from patch" }]
  }
]

